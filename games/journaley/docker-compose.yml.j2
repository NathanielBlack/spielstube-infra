services:
  companion:
    image: {{ registry_domain }}/journaley-companion:latest
    container_name: journaley-companion
    restart: always
    environment:
      - VIRTUAL_HOST=companion.journaley.spielstube.app
      - VIRTUAL_PORT=80
      - LETSENCRYPT_HOST=companion.journaley.spielstube.app
    networks:
      - proxy

  api:
    image: {{ registry_domain }}/journaley-api:latest
    container_name: journaley-api
    restart: always
    env_file: .env
    environment:
      - VIRTUAL_HOST=api.journaley.spielstube.app
      - VIRTUAL_PORT=8080
      - LETSENCRYPT_HOST=api.journaley.spielstube.app
    volumes:
      - blobs:/data/blobs
    networks:
      - proxy
      - journaley
    depends_on:
      - db

  db:
    image: postgres:16
    container_name: journaley-db
    restart: always
    environment:
      - POSTGRES_USER={{ journaley_db_user }}
      - POSTGRES_PASSWORD={{ journaley_db_password }}
      - POSTGRES_DB={{ journaley_db_name }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - journaley

volumes:
  pgdata:
  blobs:

networks:
  proxy:
    external: true
  journaley:
