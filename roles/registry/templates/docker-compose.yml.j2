services:
  registry:
    image: registry:2
    container_name: docker-registry
    restart: always
    volumes:
      - registry-data:/var/lib/registry
      - ./auth:/auth
      - ./config.yml:/etc/docker/registry/config.yml:ro
    environment:
      - VIRTUAL_HOST={{ registry_domain }}
      - VIRTUAL_PORT=5000
      - LETSENCRYPT_HOST={{ registry_domain }}
    networks:
      - proxy

volumes:
  registry-data:

networks:
  proxy:
    external: true
